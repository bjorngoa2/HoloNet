<Application x:Class="HoloNet.TvLauncher.Gallery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- The launcher's own theme (HoloNet.TvLauncher.Themes.Theme), so stories look exactly like the app. -->
        <ResourceDictionary Source="pack://application:,,,/HoloNet.TvLauncher;component/Themes/Theme.xaml" />
    </Application.Resources>
</Application>
