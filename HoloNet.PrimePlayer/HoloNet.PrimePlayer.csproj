<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- UseWPF pulls in System.Windows.Automation (UIAutomationClient/Types), which is how this
         tool finds and clicks Prime Video's "Spill av"/"Fortsett" button - no actual WPF UI is
         shown, this tool is headless/console-only. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
