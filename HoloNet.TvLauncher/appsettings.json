{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "TvLauncher": {
    "GamesApiBaseUrl": "http://games.goa.no/api/v1/games",
    "VideoCatalogApiBaseUrl": "http://videos.goa.no/api/v1/catalog",
    // The Prime Video, Disney+ and HBO Max titles in each streaming folder. Add a title with the folder's
    // "Add a title" tile, and remove one with Square / X (see TvLauncherOptions.VideoLibraryApiBaseUrl).
    "VideoLibraryApiBaseUrl": "http://videos.goa.no/api/v1/library",
    // Set true to show the "Prime Video" folder on the home screen (with a "Refresh Prime
    // Login" tile that launches HoloNet.PrimeAuth - see HoloNet.PrimeAuth/README.md, and its
    // PrimeAuthToolPath setting below).
    "PrimeVideoEnabled": true,
    "PrimeAuthToolPath": "",
    // Disney+ and HBO Max episodes play in your signed-in Firefox through PrimePlayerToolPath below.
    "DisneyPlusEnabled": true,
    "HboMaxEnabled": true,
    // Path to HoloNet.PrimePlayer.exe - automates clicking Play and going fullscreen using your
    // real Firefox install (see TvLauncherOptions.PrimePlayerToolPath). A relative path is relative
    // to the launcher's own folder; releases bundle the tool right next to HoloNet.TvLauncher.exe.
    // Leave empty to just open a movie/episode's deep link in the default browser instead.
    "PrimePlayerToolPath": "HoloNet.PrimePlayer.exe",
    "GamepadPollIntervalMs": 100,
    "GamepadStickDeadzone": 0.5,
    "EnableGamepadDebugLogging": false,
    // The screensaver itself (Ambient clock or Bouncing logo) is picked on the TV under Settings.
    // Its weather (from Open-Meteo, no API key needed) is for this PC's own location from the
    // Windows location service. To pin another place, set e.g.
    // "WeatherLatitude": 58.97, "WeatherLongitude": 5.73, "WeatherLocationName": "Stavanger".
    // Icon: Game, Video, Photo, Play, Folder, Key, Globe or Music. AccentColor: brand hex colour.
    "Shortcuts": [
      {
        "Title": "Videos", "Url": "http://videos.goa.no", "Icon": "Video", "AccentColor": "#E8833A",
        "Description": "Home videos and films from the HoloNet library."
      },
      {
        "Title": "Photos", "Url": "http://photos.goa.no", "Icon": "Photo", "AccentColor": "#2BB673",
        "Description": "Browse the family photo library."
      },
      // Kiosk tiles open fullscreen in Firefox with uBlock Origin - see Firefox/README.md.
      {
        "Title": "YouTube", "Url": "https://www.youtube.com", "Kiosk": true, "Icon": "Play", "AccentColor": "#FF0033",
        "Description": "YouTube in fullscreen, with uBlock Origin blocking the ads."
      }
    ],
    "PlatformDisplayNames": {
      "PS2": "PlayStation 2",
      "PS1": "PlayStation",
      "GameCube": "Nintendo GameCube"
    },
    "EmulatorMappings": {
      "PS2": {
        "ExecutablePath": "C:\\Program Files\\PCSX2\\pcsx2-qt.exe",
        "ArgumentsTemplate": "-fastboot -fullscreen -- \"{NetworkPath}\"",
        "HideWindow": true,
        "ForceKillOnQuit": true
      },
      "PS1": {
        "ExecutablePath": "C:\\Program Files\\DuckStation\\duckstation-qt-x64-ReleaseLTCG.exe",
        "ArgumentsTemplate": "-fullscreen \"{NetworkPath}\""
      },
      "GameCube": {
        "ExecutablePath": "C:\\Program Files\\Dolphin\\Dolphin.exe",
        "ArgumentsTemplate": "-b -e \"{NetworkPath}\""
      }
    },
    "SaveStats": {
      "Ratchet and Clank": {
        "CurrencyOffset": 36,
        "CurrencyLabel": "Bolts",
        "PlaytimeFramesOffset": 60,
        "PlaytimeFrameRate": 60.0,
