          "11": "Pokitaru (Jowai Resort)",
          "12": "Hoven (Bomb Factory)",
          "13": "Oltanis Orbit (Gemlik Base)",
          "14": "Oltanis (Gorda City Ruins)",
          "15": "Quartu (Robot Plant)",
          "16": "Kalebo III (Gadgetron Site)",
          "17": "Veldin Orbit (Drek's Fleet)"
        }
      },
      "Legend of Spyro The - The Eternal Night": {
