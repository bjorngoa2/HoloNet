<!--
    Design tokens and shared templates for the 10-foot UI. Every screen is laid out on a
    fixed 1920x1080 canvas (scaled to the TV by a Viewbox), so all sizes below are in 1080p
    pixels - the reference resolution Google TV, tvOS and Xbox guidelines are written for.
    Merged by App.xaml, and loaded on its own by the gallery and the screenshot tests (see Theme.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:HoloNet.TvLauncher.Views">
    <Color x:Key="BackgroundColor">#0B0B10</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2A36" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#A9A9B6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6E6E7C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB547" />
    <SolidColorBrush x:Key="ProgressBrush" Color="#F2F2F5" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="PromptFont">Segoe UI Semibold, Segoe UI Symbol</FontFamily>

    <CornerRadius x:Key="TileCornerRadius">12</CornerRadius>

    <!-- Motion tokens - keep in sync with Motion.cs. -->
    <Duration x:Key="FocusDuration">0:0:0.18</Duration>
    <CubicEase x:Key="StandardEase" EasingMode="EaseOut" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <views:ProgressToVisibilityConverter x:Key="ProgressToVisibilityConverter" />
    <views:ProgressToGridLengthConverter x:Key="ProgressToGridLengthConverter" />
    <views:AccentToTileBrushConverter x:Key="AccentToTileBrushConverter" />
    <views:HexToBrushConverter x:Key="HexToBrushConverter" />

    <!--
        A tile's artwork, without any focus treatment - shared by the picker tiles and the
        launch splash, so opening an app visually continues from the tile that was chosen.
        Layers: brand gradient, then icon/initials and the title (until any artwork loads),
        then the artwork itself, then the watch-progress bar.
    -->
    <DataTemplate x:Key="TileArtTemplate" DataType="{x:Type views:IPickerCard}">
        <Grid>
            <Border CornerRadius="{StaticResource TileCornerRadius}"
                    Background="{Binding AccentColor, Converter={StaticResource AccentToTileBrushConverter}}" />

            <TextBlock x:Name="ArtIcon" Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="52"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30"
                       Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock x:Name="ArtInitials" Text="{Binding InitialsGlyph}" FontFamily="{StaticResource UiFont}" FontSize="52" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30"
                       Visibility="{Binding ShowInitials, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock x:Name="ArtTitle" Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="SemiBold"
                       Foreground="White" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       VerticalAlignment="Bottom" Margin="16,0,16,18" />

            <views:ArtImage x:Name="Art" CornerRadius="{StaticResource TileCornerRadius}" DecodeWidth="640" Url="{Binding ThumbnailUrl}" />

            <!-- Title over the artwork (see IPickerCard.CaptionsArt), on a scrim so it reads on any image. -->
            <Border x:Name="ArtCaption" VerticalAlignment="Bottom" Height="80" CornerRadius="0,0,12,12" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="White" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Bottom" Margin="18,0,18,14" />
            </Border>

            <!-- "How far watched": a pill-shaped track inset from the bottom edge. -->
            <Border VerticalAlignment="Bottom" Height="6" Margin="14,0,14,14" CornerRadius="3" Background="#66000000"
                    Visibility="{Binding ProgressPercentage, Converter={StaticResource ProgressToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ProgressPercentage, Converter={StaticResource ProgressToGridLengthConverter}}" />
                        <ColumnDefinition Width="{Binding ProgressPercentage, Converter={StaticResource ProgressToGridLengthConverter}, ConverterParameter=Remainder}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="3" Background="{StaticResource ProgressBrush}" />
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <!-- The title stands in for the artwork until (unless) it has loaded. -->
            <DataTrigger Binding="{Binding HasImage, ElementName=Art}" Value="True">
                <Setter TargetName="ArtTitle" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasImage, ElementName=Art}" Value="True" />
                    <Condition Binding="{Binding CaptionsArt}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ArtCaption" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <!-- Explicit "Path=": WPF doesn't resolve an attached-property path passed positionally here. -->
            <DataTrigger Binding="{Binding Path=(views:TileArt.ShowsTitle), ElementName=ArtTitle}" Value="False">
                <Setter TargetName="ArtTitle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ArtCaption" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ArtIcon" Property="Margin" Value="0" />
                <Setter TargetName="ArtInitials" Property="Margin" Value="0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalPanelTemplate">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- A single controller button chip: round for face buttons, a pill for system buttons. -->
    <DataTemplate x:Key="ButtonPromptTemplate" DataType="{x:Type views:ButtonPrompt}">
        <Border x:Name="Chip" Height="38" MinWidth="38" CornerRadius="19" Margin="0,0,6,0" Padding="14,0"
                Background="{StaticResource SurfaceBrush}">
            <TextBlock x:Name="Symbol" Text="{Binding Symbol}" FontFamily="{StaticResource PromptFont}" FontSize="17"
                       Foreground="{Binding Color, Converter={StaticResource HexToBrushConverter}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRound}" Value="True">
                <Setter TargetName="Chip" Property="Width" Value="38" />
                <Setter TargetName="Chip" Property="Padding" Value="0" />
                <Setter TargetName="Symbol" Property="FontSize" Value="20" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ButtonHintTemplate" DataType="{x:Type views:ButtonHint}">
        <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
            <TextBlock Text="Hold" FontFamily="{StaticResource UiFont}" FontSize="22" Foreground="{StaticResource SubTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       Visibility="{Binding IsHold, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ButtonPromptTemplate}"
                          ItemsPanel="{StaticResource HorizontalPanelTemplate}" Focusable="False" />
            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource UiFont}" FontSize="22" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- The arrows around a tile the player has picked up to move (see FolderNavigator.BeginMove). -->
    <Style x:Key="MoveArrowChip" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="#F00B0B10" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="MoveArrowGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        A picker tile. There's no caption under it: the hero panel shows the focused tile's
        details. Focus is shown the way TV platforms do it: the tile scales up, gets a
        white ring and a lifted shadow, while the other tiles dim slightly. These cues read
        from across a room, where a thin border colour change does not.
    -->
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type views:IPickerCard}">
        <Grid x:Name="Tile" Width="320" Height="180" Margin="0,0,32,32" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Shadow" CornerRadius="{StaticResource TileCornerRadius}" Background="Black" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.75" />
                </Border.Effect>
            </Border>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TileArtTemplate}" />
            <Border x:Name="FocusRing" Margin="-7" CornerRadius="17" BorderThickness="4" BorderBrush="White" Opacity="0" />
            <Grid x:Name="MoveArrows" Margin="-23" Visibility="Collapsed">
                <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE76B;" />
                </Border>
                <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE76C;" />
                </Border>
                <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE70E;" />
                </Border>
                <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE70D;" />
                </Border>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMoving}" Value="True">
                <Setter TargetName="MoveArrows" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Shape}" Value="Poster">
                <Setter TargetName="Tile" Property="Width" Value="210" />
                <Setter TargetName="Tile" Property="Height" Value="280" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.08" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.08" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity"
                                             To="0.7" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
