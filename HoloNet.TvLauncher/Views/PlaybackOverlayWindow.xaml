<Window x:Class="HoloNet.TvLauncher.Views.PlaybackOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoloNet playback controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True">
    <!--
        Controller-driven playback controls drawn over a fullscreen browser: title, play state,
        timeline and button hints over a bottom scrim, in the layout TV players share. Layered
        and click-through (see FloatingWindows), so the browser keeps focus and stays fullscreen.
    -->
    <Grid x:Name="Root" Opacity="0">
        <Viewbox Stretch="Uniform" VerticalAlignment="Bottom">
            <Grid Width="1920" Height="1080">
                <Rectangle VerticalAlignment="Bottom" Height="560">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#8C000000" Offset="0.45" />
                            <GradientStop Color="#E0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel VerticalAlignment="Bottom" Margin="120,0,120,64">
                    <TextBlock x:Name="EyebrowText" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource UiFont}" FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,64" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StateGlyph" FontFamily="{StaticResource IconFont}" FontSize="34" Width="40"
                                   Foreground="{StaticResource TextBrush}" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,0,32,0" />

                        <!-- The timeline: track, elapsed fill and thumb, with the scrub target's time floating above. -->
                        <Grid x:Name="Track" Grid.Column="1" Height="28" SizeChanged="Track_SizeChanged">
                            <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="#40FFFFFF" VerticalAlignment="Center" />
                            <Rectangle x:Name="ElapsedFill" Height="6" RadiusX="3" RadiusY="3" Fill="{StaticResource ProgressBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                            <Canvas>
                                <Ellipse x:Name="Thumb" Width="22" Height="22" Canvas.Top="3" Fill="{StaticResource ProgressBrush}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="ThumbScale" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Border x:Name="ScrubBubble" Canvas.Top="-58" Height="42" Padding="16,0" CornerRadius="8"
                                        Background="{StaticResource SurfaceBrush}" Opacity="0" SizeChanged="ScrubBubble_SizeChanged">
                                    <TextBlock x:Name="ScrubText" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" />
                                </Border>
                            </Canvas>
                        </Grid>

                        <Grid x:Name="TimesRow" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                            <TextBlock x:Name="ElapsedText" FontFamily="{StaticResource UiFont}" FontSize="22"
                                       Foreground="{StaticResource SubTextBrush}" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="RemainingText" FontFamily="{StaticResource UiFont}" FontSize="22"
                                       Foreground="{StaticResource SubTextBrush}" Typography.NumeralAlignment="Tabular"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <ItemsControl x:Name="HintsList" ItemTemplate="{StaticResource ButtonHintTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanelTemplate}"
                                  Margin="0,40,0,0" Focusable="False" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
