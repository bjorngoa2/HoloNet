<UserControl x:Class="HoloNet.TvLauncher.Views.HeroDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!--
        Details of the focused tile, shown above the tile rows instead of as captions under
        every tile - the "hero" pattern of Google TV, tvOS and Xbox, which keeps the grid
        calm and gives the one thing in focus room for a readable synopsis.
    -->
    <Grid x:Name="Root" VerticalAlignment="Bottom">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootOffset" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" MaxWidth="1000" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource UiFont}" FontSize="64" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                       LineStackingStrategy="BlockLineHeight" LineHeight="72" MaxHeight="144" />
            <TextBlock x:Name="MetaText" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            <TextBlock x:Name="DescriptionText" FontFamily="{StaticResource UiFont}" FontSize="24"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                       LineStackingStrategy="BlockLineHeight" LineHeight="34" MaxHeight="102" Margin="0,18,0,0" />
            <TextBlock x:Name="DetailsText" FontFamily="{StaticResource UiFont}" FontSize="22"
                       Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,16,0,0" />
        </StackPanel>

        <StackPanel x:Name="PreviewPanel" Grid.Column="1" VerticalAlignment="Bottom" Margin="48,0,0,0" Visibility="Collapsed">
            <TextBlock Text="Last session" FontFamily="{StaticResource UiFont}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />
            <Border Width="448" Height="252" CornerRadius="{StaticResource TileCornerRadius}" Background="{StaticResource SurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.5" />
                </Border.Effect>
                <Border CornerRadius="{StaticResource TileCornerRadius}">
                    <Border.Background>
                        <ImageBrush x:Name="PreviewBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
