<Window x:Class="HoloNet.TvLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoloNet TV Launcher"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="260" />
            <Style.Triggers>
                <!-- Folder tiles ("Games", platform folders) are already distinguished from
                     game/shortcut tiles by their 📁 glyph (see FolderCardViewModel.InitialsGlyph),
                     so they don't need a separate always-on border treatment too. -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CardSelectedBrush}" />
                    <Setter Property="Background" Value="#26263A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="HoloNet — Home" Foreground="{StaticResource TextBrush}"
                   FontSize="32" FontWeight="Bold" Margin="32,24,32,12" />

        <ScrollViewer Grid.Row="1" x:Name="GridScrollViewer" VerticalScrollBarVisibility="Auto" Margin="20,0">
            <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#33344A" CornerRadius="6" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding InitialsGlyph}" FontSize="48" FontWeight="Bold"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowInitials, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,2" />

                                <TextBlock Grid.Row="2" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                           Text="{Binding Subtitle, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource SubTextBrush}"
                   FontSize="14" Margin="32,8,32,16" TextWrapping="Wrap" />

        <TextBlock x:Name="SaveInfoText" Grid.Row="1" Foreground="{StaticResource TextBrush}"
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,12"
                   Background="#AA0D0D12" Padding="12,8" Visibility="Collapsed" />

        <!--
            "Where I currently am" showcase: a larger preview of the screenshot captured the
            last time the player quit the selected game, shown docked at the bottom-left of the
            grid (underneath the row of cards) rather than replacing the card's own cover-art
            thumbnail. Populated/shown from code-behind (see UpdateSaveInfo) since it tracks
            whichever card is currently selected.
        -->
        <Border x:Name="ShowcaseBorder" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="32,0,0,12" Background="#AA0D0D12" CornerRadius="6" Padding="6" Visibility="Collapsed">
            <Image x:Name="ShowcaseImage" Width="480" Height="270" Stretch="Uniform" />
        </Border>

        <!-- Full-screen overlay shown while an emulator has focus / during load / on error. -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="3" Background="#DD0D0D12" Visibility="Collapsed">
            <TextBlock x:Name="OverlayText" Foreground="{StaticResource TextBrush}" FontSize="28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="800" />
        </Grid>

        <!--
            Idle screensaver: mostly-black background (so the static card grid isn't left
            displayed for hours) with a small dim logo that continuously drifts and bounces off
            the edges (classic "DVD logo" pattern) so no single group of pixels stays lit at
            constant brightness — burn-in protection for OLED TVs in particular. Any input
            dismisses it (see MainWindow.xaml.cs).
        -->
        <Grid x:Name="ScreensaverGrid" Grid.RowSpan="3" Background="Black" Visibility="Collapsed">
            <TextBlock x:Name="ScreensaverLogo" Text="HoloNet" FontSize="28" FontWeight="Bold"
                       Foreground="#33FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ScreensaverLogoTransform" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
