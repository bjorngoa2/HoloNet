<Window x:Class="HoloNet.TvLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HoloNet.TvLauncher.Views"
        Title="HoloNet TV Launcher"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- The arrows around a tile the player has picked up to move (see FolderNavigator.BeginMove). -->
        <Style x:Key="MoveArrowChip" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#F00B0B10" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="MoveArrowGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            A picker tile. There's no caption under it: the hero panel shows the focused tile's
            details. Focus is shown the way TV platforms do it: the tile scales up, gets a
            white ring and a lifted shadow, while the other tiles dim slightly. These cues read
            from across a room, where a thin border colour change does not.
        -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:IPickerCard}">
            <Grid x:Name="Tile" Width="320" Height="180" Margin="0,0,32,32" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform />
                </Grid.RenderTransform>

                <Border x:Name="Shadow" CornerRadius="{StaticResource TileCornerRadius}" Background="Black" Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.75" />
                    </Border.Effect>
                </Border>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TileArtTemplate}" />
                <Border x:Name="FocusRing" Margin="-7" CornerRadius="17" BorderThickness="4" BorderBrush="White" Opacity="0" />
                <Grid x:Name="MoveArrows" Margin="-23" Visibility="Collapsed">
                    <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE76B;" />
                    </Border>
                    <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE76C;" />
                    </Border>
                    <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE70E;" />
                    </Border>
                    <Border Style="{StaticResource MoveArrowChip}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource MoveArrowGlyph}" Text="&#xE70D;" />
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMoving}" Value="True">
                    <Setter TargetName="MoveArrows" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="Poster">
                    <Setter TargetName="Tile" Property="Width" Value="210" />
                    <Setter TargetName="Tile" Property="Height" Value="280" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity"
                                                 To="0.7" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{StaticResource FocusDuration}" EasingFunction="{StaticResource StandardEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!--
            Everything is laid out on a fixed 1920x1080 canvas and scaled to the TV, so the UI
            looks identical on a 1080p or 4K panel. Content stays inside a 5% "title safe" margin
            (96x54), because many TVs overscan or crop the outer edge.
        -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <local:HeroBackdrop x:Name="Backdrop" />

                <Grid Margin="96,54,96,54">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="380" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top bar: wordmark and location on the left, status and clock on the right. -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="HoloNet" FontFamily="{StaticResource UiFont}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <Rectangle Width="2" Height="26" Margin="20,0" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LocationText" FontFamily="{StaticResource UiFont}" FontSize="30"
                                       Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="NoticeText" FontFamily="{StaticResource UiFont}" FontSize="22"
                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,36,0"
                                       MaxWidth="1000" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ClockText" FontFamily="{StaticResource UiFont}" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <local:HeroDetails x:Name="Hero" Grid.Row="1" Margin="0,0,0,28" />

                    <!--
                        Tile grid. The negative horizontal margin plus matching padding gives
                        the focused tile's scale and ring room to grow without being clipped.
                        It also reaches 6px up into the hero's bottom margin (offset by the
                        content's top padding), leaving room for the top edge fade above the
                        focused tile's ring; see TileGridScroll for the fade and scroll rules.
                    -->
                    <ScrollViewer x:Name="GridScrollViewer" Grid.Row="2" Margin="-40,-6,-40,0" Focusable="False"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="OnGridViewportSizeChanged">
                        <ItemsControl x:Name="TilesItemsControl" Margin="40,30,8,0" Focusable="False"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform x:Name="TilesOffset" />
                            </ItemsControl.RenderTransform>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Button hints for what the controller can do right now, and the app version. -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <ItemsControl x:Name="HintsList" ItemTemplate="{StaticResource ButtonHintTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanelTemplate}" Focusable="False" />
                        <TextBlock x:Name="VersionText" FontFamily="{StaticResource UiFont}" FontSize="18"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>

        <local:SplashOverlay x:Name="Splash" />

        <!--
            Idle screensaver, shown after a few minutes without input so the bright tile grid
            isn't left on for hours (an OLED burn-in risk). ScreensaverController fills it with
            the scene chosen in Settings (see IScreensaverScene) and any input dismisses it. It
            sits outside the Viewbox so each scene decides how it scales.
        -->
        <Grid x:Name="ScreensaverGrid" Background="Black" Visibility="Collapsed" />
    </Grid>
</Window>
