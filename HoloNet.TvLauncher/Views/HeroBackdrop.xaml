<UserControl x:Class="HoloNet.TvLauncher.Views.HeroBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <!--
        Full-bleed ambience behind the whole home screen (the Google TV / tvOS "hero" pattern):
        a soft glow in the focused tile's brand colour, plus its artwork faded into the
        background from the top-right so it never competes with the text and tiles on the left.
    -->
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.8" RadiusY="1.1">
                    <GradientStop x:Name="GlowStop" Color="#663D6BFF" Offset="0" />
                    <GradientStop x:Name="GlowEdgeStop" Color="#003D6BFF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--
            Masks: fade in from the left, and out towards the bottom - fully gone by the top of
            the tile row (y ~500), so logos baked into the art never clash with the tiles. The art
            is also dimmed under the top bar (a "top scrim") so its status text reads on any image.
        -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="1380" Height="776">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#B0000000" Offset="0.35" />
                    <GradientStop Color="#FF000000" Offset="0.6" />
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid>
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A000000" Offset="0" />
                        <GradientStop Color="#4D000000" Offset="0.12" />
                        <GradientStop Color="#FF000000" Offset="0.3" />
                        <GradientStop Color="#00000000" Offset="0.64" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Image x:Name="LayerA" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="LayerB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
