<Window x:Class="HoloNet.TvLauncher.Views.PlaybackCurtainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HoloNet.TvLauncher.Views"
        Title="HoloNet playback curtain"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True">
    <!--
        The launch splash, kept above the browser while PrimePlayer clicks Play and goes
        fullscreen behind it. Layered (AllowsTransparency) and click-through (see code-behind),
        so the automation's clicks and keys still reach the browser.
    -->
    <local:SplashOverlay x:Name="Splash" />
</Window>
