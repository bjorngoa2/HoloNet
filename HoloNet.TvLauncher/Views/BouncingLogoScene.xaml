<UserControl x:Class="HoloNet.TvLauncher.Views.BouncingLogoScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!--
        The classic "DVD logo": a small dim logo drifting across a black screen and bouncing off
        the edges. It moves in real window pixels, so it isn't scaled like the 1920x1080 home
        screen.
    -->
    <Canvas ClipToBounds="True">
        <TextBlock x:Name="Logo" Text="HoloNet" FontFamily="{StaticResource UiFont}" FontSize="28" FontWeight="Bold"
                   Foreground="#33FFFFFF">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="LogoTransform" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</UserControl>
