{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VideoService": {
    "VideoPath": "data/videos",
    "BaseUrl": "http://localhost:5044/api/v1/videos"
  },
  // PrimeVideo:SessionCookie is intentionally omitted here - never commit a real cookie value.
  // Set it via the PrimeVideo__SessionCookie environment variable, or `dotnet user-secrets set
  // "PrimeVideo:SessionCookie" "..."` locally. Without it, the Prime Video provider is skipped.
  "PrimeVideo": {
    "Region": "eu",
    "BaseUrl": "https://www.primevideo.com"
  },
  // Disney+ needs no credentials: its catalog comes from the public series pages, and playback
  // happens in the user's own signed-in browser. Locale picks the language of titles and links.
  "DisneyPlus": {
    "BaseUrl": "https://www.disneyplus.com",
    "Locale": "en-gb"
  },
  // HBO Max needs no credentials either: its catalog comes from the public title pages. Its
  // catalog differs per country, so Country should match the subscription; Language picks the
  // language of titles and synopses.
  "HboMax": {
    "BaseUrl": "https://www.hbomax.com",
    "PlayBaseUrl": "https://play.hbomax.com",
    "Country": "no",
    "Language": "en"
  }
}
