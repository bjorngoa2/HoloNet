## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

**/bin/
**/obj/
**/out/
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
TestResults/


# macOS
.DS_Store

# .NET build output, recursively
**/bin/
**/obj/

# Optional project/user files
*.http
*.csproj.user
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE folders
.vs/

# Service data directories (media files, game metadata — not committed)
HoloNet.Video/data/
HoloNet.Photos/data/
HoloNet.Games/data/

# Frontend build output and dependencies
HoloNet.Portal/wwwroot/
HoloNet.Portal/ClientApp/node_modules/

# Local-only config overrides (machine-specific overrides for dev/testing, never committed)
appsettings.local.json

# Auto-recorded unmapped save-file location/level IDs (see LocationDiscoveryService) — personal
# working notes for reverse-engineering, not meant to be committed.
discovered-locations.json

# Screenshot showcase captures per game (see GameScreenshotService) — personal, machine-specific.
HoloNet.TvLauncher/Screenshots/
HoloNet.TvLauncher/screenshot-errors.log
